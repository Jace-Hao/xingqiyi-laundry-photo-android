# ---------- Gradle / IDE ----------
*.iml
.gradle
.kotlin
/.idea
/captures
.externalNativeBuild
.cxx
.DS_Store

# 注意：必须写 build/ 而非 /build。
# 带前导斜杠只匹配仓库根目录的 build，无法屏蔽各模块（如 app/build），
# 会把 kapt 生成代码、aar 产物等数千个文件提交进仓库。
build/

# 本机 SDK 路径，含绝对路径，不入库
local.properties

# ---------- 签名密钥 ----------
# 发布签名信息切勿入库：丢失后无法覆盖升级已安装的 App，用户只能卸载重装并丢数据。
*.jks
*.keystore

# ---------- 打包产物 ----------
# APK 体积大，发布时作为 Release 附件上传，不进仓库
release-apk/
*.apk
*.aab

# Windows 保留设备名：本机误生成的垃圾文件，无法正常读取/删除
nul
